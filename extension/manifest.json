{
  "manifest_version": 3,
  "name": "Salta Acortadores",
  "version": "1.0.0",
  "description": "Salta las páginas de anuncios de los acortadores y te lleva directo al enlace original cuando es posible.",
  "icons": {
    "16": "iconos/icono-16.png",
    "32": "iconos/icono-32.png",
    "48": "iconos/icono-48.png",
    "128": "iconos/icono-128.png"
  },
  "action": {
    "default_title": "Salta Acortadores",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "iconos/icono-16.png",
      "32": "iconos/icono-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/desacortador.js", "lib/ajustes.js", "background.js"]
  },
  "permissions": ["storage", "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/desacortador.js", "lib/ajustes.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "opciones.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "salta-acortadores@acortar-link",
      "strict_min_version": "121.0"
    }
  }
}
